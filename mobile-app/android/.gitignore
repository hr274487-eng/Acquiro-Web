# This file is used to prevent the distribution of generated files
# specific to the Android toolchain.

# Generated files
/build
/.gradle

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Cache of project
.gradletasknamecache

